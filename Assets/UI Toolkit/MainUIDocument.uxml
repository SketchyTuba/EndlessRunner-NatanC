<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="MainUIDocument.uss" />
    <ui:VisualElement name="RootContainer" class="root-container">
        
        <!-- Top HUD Bar -->
        <ui:VisualElement name="TopHeader" class="top-header">
            <ui:Label name="scoreLabel" text="Score: 0" class="hud-label" />
            <ui:Label name="timeLabel" text="Time Remaining: 0" class="hud-label" />
        </ui:VisualElement>

        <!-- Center Start Menu -->
        <ui:VisualElement name="CenterMenu" class="center-menu">
            <ui:VisualElement name="InkMenuCard" class="ink-card">
                <ui:RadioButtonGroup name="timerRadio" choices="Infinite Game,One Minute Game" value="0" class="ink-radio-group" />
                <ui:Button name="startButton" text="Start" class="ink-start-button" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>